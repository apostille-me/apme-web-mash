BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
RUST_LOG=info,tower_http=info
SHARED_AUTH_BASE_URL=https://auth.example.invalid
SHARED_AUTH_ISSUER=https://auth.example.invalid/realms/apostille-me
SHARED_AUTH_AUDIENCE=apostille-me
SHARED_AUTH_INTROSPECTION_CREDENTIAL=replace-with-independent-service-credential

# Optional bounded stateless HTTP avenue.
# APME_API_HTTP_BASE=https://api.apostille.me

# Optional persistent mTLS avenue. All values become mandatory together.
# APME_API_TCP_ADDRESS=apme-api.internal:9443
# APME_API_TCP_SERVER_NAME=apme-api.internal
# APME_API_TCP_CA_FILE=/run/secrets/apme-api-ca.crt
# APME_API_TCP_CLIENT_CERT_FILE=/run/secrets/apme-web-client.crt
# APME_API_TCP_CLIENT_KEY_FILE=/run/secrets/apme-web-client.key

# Optional durable status avenue. Credentials never belong in the URL or Git.
# APME_NATS_URL=tls://nats.internal:4222
# APME_NATS_CREDENTIALS_FILE=/run/secrets/apme-web.creds
